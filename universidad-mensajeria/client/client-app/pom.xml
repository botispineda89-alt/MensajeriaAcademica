<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>universidad.mensajeria</groupId>
        <artifactId>mensajeria-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>client-app</artifactId>
    <name>Client App</name>
    <description>Cliente Java de escritorio (principal): presentacion + fachada + componentes + persistencia</description>

    <properties>
        <javafx.version>22.0.2</javafx.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>2.1.0</version>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>client-interfaces</artifactId>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>dto</artifactId>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>codec</artifactId>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- FASE 13.4: compile (no runtime): LocalStore usa el pool del driver. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Historial remoto (Fase 13.12): parsear HISTORIAL_PAGE del servidor. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- UIX-27 / PLAN_AMBOS 2.2: lector WebP para ImageIO (plugin SPI puro,
             BSD-3). Sin esto ni JavaFX ni ImageIO saben abrir un .webp, y el
             servidor lo rechaza por magic bytes, asi que el unico sitio donde
             el .webp se puede recuperar es aqui: se transcodifica a PNG y a
             partir de ahi es una imagen normal para los tres clientes.
             TwelveMonkeys se registra solo por META-INF/services: no hay que
             llamar a ImageIO.scanForPlugins(). -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>3.12.0</version>
        </dependency>

        <!-- FORMATOS-01: rasterizador SVG (Apache-2, un solo jar puro). Un SVG
             no es un stream de ImageIO, asi que TranscodificadorImagen lo pinta
             sobre un Graphics2D para llevarlo a PNG solo para la vista. -->
        <dependency>
            <groupId>com.github.weisj</groupId>
            <artifactId>jsvg</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- FORMATOS-01: puente con ImageMagick para lo que la pila del cliente
             no abre (AVIF/HEIC si el SPI no cubre la variante). Misma herramienta
             y autodeteccion que el servidor (DecodificadorMagick); Apache-2. -->
        <dependency>
            <groupId>org.im4java</groupId>
            <artifactId>im4java</artifactId>
            <version>1.4.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>universidad.mensajeria.cliente.ClienteMain</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
